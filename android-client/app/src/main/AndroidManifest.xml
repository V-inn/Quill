<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Quill"
        android:theme="@android:style/Theme.Black.NoTitleBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Milestone 8: launched automatically when the daemon
                 switches the tablet into AOA accessory mode over USB
                 (bypassing adb) and the strings in accessory_filter.xml
                 match what daemon/src/aoa.rs sends. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>
        <!-- Reached from the gear, or from the status overlay while
             disconnected; the main activity runs edge-to-edge immersive with no
             system chrome to hang a menu off.

             NoTitleBar, and no android:label: with a title bar this activity
             drew "Quill settings" twice, once as system chrome from the label
             and once as the screen's own first heading. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />
    </application>
</manifest>
