[Unit]
Description=Quill daemon (AOA transport, auto-launched on tablet USB attach)
# Caps rapid-restart loops if the daemon keeps failing right after launch
# (e.g. portal token got revoked and no one's at the keyboard to re-pick).
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# `+`: run this one outside the sandbox below.
#
# A directory named in ReadWritePaths that does not exist is fatal, and the
# failure names neither the directory nor the setting:
#
#   Failed at step NAMESPACE spawning /usr/bin/quill-daemon: No such file or
#   directory
#   Main process exited, code=exited, status=226/NAMESPACE
#
# ("No such file or directory" reads like a missing binary. It is not.)
# Verified on systemd 257: the same unit starts with this line and fails
# 226/NAMESPACE without it.
#
# So the directories have to exist before the namespace is built, which means
# they cannot be created from inside it -- by then ProtectSystem=strict has
# made the whole hierarchy read-only. `+` exempts this one command from that.
#
# install.sh creates the same two directories, which is why none of this was
# needed while a hand install was the only kind there was. A package cannot: it
# runs once, as root, and has no business walking every user's home directory.
ExecStartPre=+/usr/bin/mkdir -p %h/.local/share/quill %h/.config/quill
ExecStart=%h/.local/bin/quill-daemon %h/.local/share/quill/output.h264 aoa
Restart=on-failure
RestartSec=2

# --- Sandboxing -------------------------------------------------------------
# This is a `systemd --user` unit, so it never held privileges to drop. The
# point of everything below is to shrink what a *compromised* daemon could
# reach -- which is the question a security reviewer actually asks when this
# project requests a udev rule for /dev/uinput.
#
# Each directive here was verified to leave the daemon working, not merely to
# be accepted by systemd: under this exact set, the VAAPI encoder still
# produced 150 frames at 2560x1600, /dev/uinput still opened, and libusb,
# PipeWire and the session bus were all still reachable.

NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# PipeWire, D-Bus and udev over local sockets; loopback TCP only in the
# adb-forward transport. Nothing else -- the AOA default needs no network at
# all, and the daemon never listens on one.
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

# Read-only everywhere except the two directories the daemon actually writes:
# the captured-video dump and the portal restore token.
ProtectSystem=strict
ReadWritePaths=%h/.local/share/quill %h/.config/quill

ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes

# 0600 on anything the daemon creates. The portal restore token sets its mode
# explicitly (see `save_restore_token` in portal_capture.rs) rather than
# relying on this, but this covers the video dump and anything added later by
# someone not thinking about permissions.
UMask=0077

# Deliberately NOT set. Listed so the gaps read as decisions:
#
#   ProtectHome=            The daemon writes the capture dump and the portal
#                           token under $HOME. ReadWritePaths above is the
#                           narrower form of the same restriction.
#
#   PrivateDevices=         Would swap /dev for a minimal set containing
#                           neither /dev/uinput nor the DRM render node --
#                           i.e. it would disable both the tablet and the
#                           hardware encoder.
#
#   CapabilityBoundingSet=  A user manager rejects it as privileged, and a
#                           --user unit holds no capabilities to bound in the
#                           first place.
